{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagehold.local/schemas/archive-manifest.schema.json",
  "title": "PageHold Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format_version", "manifest_id", "archive_id", "site_id", "capture_id", "captured_at", "entry_page_id", "pages", "resources"],
  "properties": {
    "schema": {"const": "pagehold.archive-manifest.v1"},
    "format_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^manifest_[A-Za-z0-9_-]{16,64}$"},
    "archive_id": {"type": "string", "pattern": "^archive_[A-Za-z0-9_-]{16,64}$"},
    "site_id": {"type": "string", "pattern": "^site_[A-Za-z0-9_-]{16,64}$"},
    "capture_id": {"type": "string", "pattern": "^capture_[A-Za-z0-9_-]{16,64}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "entry_page_id": {"type": "string", "pattern": "^page_[A-Za-z0-9_-]{16,64}$"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$"},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_url", "final_url", "status", "content_type", "bytes", "digest", "resource_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^page_[A-Za-z0-9_-]{16,64}$"},
        "source_url": {"type": "string", "format": "uri"},
        "final_url": {"type": "string", "format": "uri"},
        "status": {"type": "integer", "minimum": 0, "maximum": 999},
        "content_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "bytes": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"},
        "resource_ids": {"type": "array", "items": {"type": "string", "pattern": "^resource_[A-Za-z0-9_-]{16,64}$"}, "uniqueItems": true}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_url", "final_url", "status", "content_type", "bytes", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^resource_[A-Za-z0-9_-]{16,64}$"},
        "source_url": {"type": "string"},
        "final_url": {"type": "string"},
        "status": {"type": "integer", "minimum": 0, "maximum": 999},
        "content_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "bytes": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
