[Unit]
Description=Create and verify a PageHold backup
After=websnapshot.service

[Service]
Type=oneshot
User=websnapshot
Group=websnapshot
WorkingDirectory=/opt/websnapshot
EnvironmentFile=/etc/websnapshot/websnapshot.env
ExecStart=/opt/websnapshot/.venv/bin/python /opt/websnapshot/websnapshot_admin.py backup /var/backups/websnapshot --keep-days 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/websnapshot /var/backups/websnapshot
