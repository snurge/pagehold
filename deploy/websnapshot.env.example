WEBSNAPSHOT_ENV=production
WEBSNAPSHOT_DATA_DIR=/var/lib/websnapshot
WEBSNAPSHOT_BIND=127.0.0.1
PORT=18765
WEBSNAPSHOT_ALLOWED_HOSTS=archive.example.com
# Required for public third-party releases so users can obtain this deployed source.
PAGEHOLD_SOURCE_URL=https://github.com/snurge/pagehold
WEBSNAPSHOT_TRUST_PROXY=1
WEBSNAPSHOT_SECURE_COOKIES=1
WEBSNAPSHOT_SECRET=replace-with-at-least-32-random-characters
WEBSNAPSHOT_ALLOW_PRIVATE_NETWORKS=0
WEBSNAPSHOT_IGNORE_HTTPS_ERRORS=0
WEBSNAPSHOT_MAX_REQUEST_BODY_BYTES=65536
WEBSNAPSHOT_MAX_AVATAR_BYTES=2097152
WEBSNAPSHOT_MIN_FREE_DISK_BYTES=5368709120
WEBSNAPSHOT_REPEATED_FAILURE_THRESHOLD=3
WEBSNAPSHOT_CRAWL_DEPTH=3
WEBSNAPSHOT_CRAWL_MAX_PAGES=25
WEBSNAPSHOT_CRAWL_DELAY_SECONDS=5
WEBSNAPSHOT_ASSET_FETCH_DELAY_SECONDS=0.25
# Optional visual evidence increases capture time and archive storage.
WEBSNAPSHOT_CAPTURE_SCREENSHOT_EVIDENCE=0
WEBSNAPSHOT_CAPTURE_PDF_EVIDENCE=0
