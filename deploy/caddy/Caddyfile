archive.example.com {
    encode zstd gzip

    request_body {
        max_size 64KB
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        -Server
    }

    reverse_proxy 127.0.0.1:18765 {
        header_up X-Real-IP {remote_host}
        health_uri /health
        health_headers {
            Host archive.example.com
        }
        health_interval 30s
        health_timeout 3s
    }
}
