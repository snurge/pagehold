<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pagehold.local</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ABSOLUTE/PATH/WebSnapshot/service_runner.py</string>
    <string>/ABSOLUTE/PATH/WebSnapshot-data/websnapshot.env</string>
    <string>/ABSOLUTE/PATH/WebSnapshot/.venv/bin/python</string>
    <string>/ABSOLUTE/PATH/WebSnapshot/app.py</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/WebSnapshot</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/WebSnapshot-data/run/websnapshot.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/WebSnapshot-data/run/websnapshot.log</string>
  <key>Umask</key><integer>63</integer>
</dict>
</plist>
